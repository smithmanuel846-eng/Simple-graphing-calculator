package Graphing_Calculator;

import java.util.ArrayList;

public class Solver {

    //No constructor needed, All methods will be static


    //Simple functions
    public static ArrayList simpleLinear(String equ)
    {
        ArrayList<Double> points = new ArrayList<Double>();
        double x = -100;
        double y = 0;
        while (x <=100)
            {
                y = x;
                points.add(x);
                points.add(y);
                x++;

            }

            return points;

    }

    public static ArrayList simplequad(String equ)
    {
        ArrayList<Double> points = new ArrayList<Double>();
        double x = -100;
        double y = 0;
        while(x <= 100)
            {

                y = Math.pow(x,2);
                
                points.add(x);
                points.add(y);
                
                x = x + 0.01;
               

            }
           
            return points;
    }


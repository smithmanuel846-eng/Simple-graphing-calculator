package Graphing_Calculator;

import java.awt.*;
import java.awt.geom.Line2D;
import java.util.ArrayList;

import javax.swing.JPanel;

public class MyPanel extends JPanel {
    private static ArrayList<Double> cords;

   public MyPanel()
    {
        setPreferredSize(new Dimension(500,500));
    }

    public static void setList(ArrayList list)
    {
        cords = list;

    }
    public void paint(Graphics g)
    {
        Graphics2D g2d = (Graphics2D) g;

        g2d.drawLine(0,250, 500,250);
        g2d.drawLine(250,0,250,500);
        g2d.translate(250,250);
        g2d.scale(4,-4);

        for (int i = 0; i < cords.size()-1; i+=2)
            {
             Line2D.Double line = new Line2D.Double(cords.get(i),cords.get(i+1),cords.get(i),cords.get(i+1));
             g2d.draw(line);
            }
        




    }
    
}
